# Copie para .env e preencha. NUNCA commite o .env real.

# Chave de sessão do Flask (>= 32 bytes aleatórios)
SECRET_KEY=troque-por-uma-string-aleatoria-de-32-bytes

# Hash da senha do mestre.
# Formato esperado: scrypt:32768:8:1$SALT$HASH
# Gere com: python -c "from werkzeug.security import generate_password_hash as g; print(g('sua-senha'))"
# NÃO adicione o prefixo "scrypt:" manualmente — o comando acima já o inclui.
MASTER_PASSWORD_HASH=cole-aqui-o-hash-gerado

# Ambiente (production liga cookies Secure)
FLASK_ENV=development
